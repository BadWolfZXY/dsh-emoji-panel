{
  "name": "dsh-emoji-panel",
  "version": "1.0.0",
  "description": "Emoji picker for the DeepSeek Harness composer: category tabs, permanent search, recents, and your own meme library with captions the model can read.",
  "license": "MIT",
  "author": "BadWolfZXY",
  "private": false,
  "type": "module",
  "homepage": "https://github.com/BadWolfZXY/dsh-emoji-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BadWolfZXY/dsh-emoji-panel.git"
  },
  "bugs": {
    "url": "https://github.com/BadWolfZXY/dsh-emoji-panel/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "emoji",
    "emoticon",
    "picker",
    "composer"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "index.json",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
